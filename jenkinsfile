pipeline {
    agent any

    environment {
        IMAGE_NAME = 'mywebsite'
        CONTAINER_NAME = 'mywebsite'
        APP_SERVER = '56.228.9.108'
        APP_USER = 'ec2-user'
    }

    stages {

        stage('Checkout Code') {
            steps {
                git branch: 'mybranch',
                    url: 'https://github.com/kavima101-netizen/cicd-automated.git'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t mywebsite:latest .'
            }
        }

        stage('Transfer Image') {
            steps {
                sh '''
                    docker save mywebsite:latest | gzip > mywebsite.tar.gz

                    scp mywebsite.tar.gz \
                    ${APP_USER}@${APP_SERVER}:/tmp/mywebsite.tar.gz
                '''
            }
        }

        stage('Deploy to Application Server') {
            steps {
                sh '''
                    ssh ${APP_USER}@${APP_SERVER} \
                    "gunzip -c /tmp/mywebsite.tar.gz | sudo docker load"
                '''

                sh '''
                    ssh ${APP_USER}@${APP_SERVER} \
                    "sudo docker rm -f mywebsite || true"
                '''

                sh '''
                    ssh ${APP_USER}@${APP_SERVER} \
                    "sudo docker run -d \
                    --name mywebsite \
                    --restart unless-stopped \
                    -p 80:80 \
                    mywebsite:latest"
                '''
            }
        }
    }
}
